# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.piolat.com

# Envoi des formulaires via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO=service-client@piolat.fr
CONTACT_FROM="Site Piolat <site@piolat.fr>"
# Optionnel : audience Resend pour la newsletter (sinon, un email de notification est envoyé)
RESEND_AUDIENCE_ID=

# Démo (ex. Vercel) : 1 = site non indexé et formulaires simulés sans Resend
DEMO_MODE=
